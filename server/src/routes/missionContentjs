import { Router } from "express"
import MissionContent from "../models/missionContent.js"
const missionContentRouter = Router()

missionContentRouter.post('/mission-contents', async (req, res) => {
const data = await MissionContent.create(req.body)
if(data) res.json({ message: "Mission content created successfully",data})
else res.status(400).json({message:"Failed to create mission content"})
  })



  missionContentRouter.get('/mission-contents', async (req, res) => {
    const data = await MissionContent.find()
    return res.send(data)
  })
export default missionContentRouter